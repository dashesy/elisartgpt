[Unit]
Description=elisart server (Codex-backed art API)
After=network-online.target
Wants=network-online.target

[Service]
User=%i
# {{VM_REPO}} is filled in by `make vm-config` from ELISART_VM_REPO in .env.
WorkingDirectory=/home/%i/{{VM_REPO}}/server
EnvironmentFile=/home/%i/{{VM_REPO}}/.env
ExecStart=/home/%i/{{VM_REPO}}/server/.venv/bin/python -m uvicorn elisart.main:app --host ${ELISART_HOST} --port ${ELISART_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
