# Public HTTPS front for the server. `make vm-config` fills in {{PUBLIC_HOST}} from
# ELISART_PUBLIC_URL in .env: the VM's public IP spelled with dashes under
# sslip.io, so no DNS setup is needed and Caddy fetches the certificate itself.
{{PUBLIC_HOST}} {
	encode gzip
	# Image turns take 30-60 s; keep the proxy patient.
	reverse_proxy 127.0.0.1:8787 {
		transport http {
			response_header_timeout 5m
		}
	}
}
