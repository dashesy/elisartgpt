# Copy to .env (gitignored). mise loads it automatically in this directory.

# Bearer token the Android app must present. Generate: openssl rand -hex 32
ELISART_TOKEN=change-me

# Bind only to the Tailscale interface on the VM; 127.0.0.1 for local dev.
ELISART_HOST=127.0.0.1
ELISART_PORT=8787

# Where drawings (copied PNGs + thread ids) are stored. Relative = under the repo.
ELISART_DATA_DIR=data

# Override only if codex is not on PATH.
# ELISART_CODEX_BIN=codex
