# Copy to .env (gitignored). mise loads it automatically in this directory.
# There is no shared secret here: people authenticate with invite codes minted
# by `make code NAME=elisa`, stored hashed in data/codes.json.

# Bind address. 127.0.0.1 behind Caddy on the VM, or for local dev.
ELISART_HOST=127.0.0.1
ELISART_PORT=8787

# Where drawings, codes and the uploaded APK live. Relative = under the repo.
ELISART_DATA_DIR=data

# Drawings per person per rolling hour.
ELISART_RATE_LIMIT_PER_HOUR=20

# The address people open to download the app; the Android build bakes it in.
# On the VM, the public IP spelled with dashes under sslip.io needs no DNS.
ELISART_PUBLIC_URL=https://1-2-3-4.sslip.io

# Public download page + APK + update check. Turn off when nobody new needs
# the app; the API for existing phones is unaffected. (make downloads-on/off)
ELISART_DOWNLOADS=true

# Override only if codex is not on PATH.
# ELISART_CODEX_BIN=codex

# --- Hosting. Read by the Makefile, deploy templates and the Android build,
# not by the server. Machine-specific values live only here, never in git.
# ssh alias of the VM, and the checkout path on it (relative to $HOME).
ELISART_VM=my-vm
ELISART_VM_REPO=elisartgpt
# Optional: Azure resource group + VM name, so `make vm-status` shows power state.
ELISART_AZ_RG=
ELISART_AZ_VM=
